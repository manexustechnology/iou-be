APP_ENVIRONMENT=local
PORT=4000
# Required outside "local" unless TENZRO_API_KEY is set. Generate with: openssl rand -hex 32
CANTON_JWT_SECRET=
TENZRO_API_KEY=
CORS_ORIGIN=http://localhost:3000
# Who may act as which ledger party: <key>=<partyId>, comma separated.
# Generate each key with: openssl rand -hex 24
PARTY_API_KEYS=
